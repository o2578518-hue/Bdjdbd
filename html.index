
{
  "name": "login-notifications",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  }
}

const { onCall, HttpsError } = require("firebase-functions/v2/https");
const { defineSecret, defineString } = require("firebase-functions/params");
const { initializeApp } = require("firebase-admin/app");
const { getFirestore } = require("firebase-admin/firestore");

initializeApp();

const db = getFirestore();

const RESEND_API_KEY = defineSecret("RESEND_API_KEY");
const NOTIFY_EMAIL = defineString("NOTIFY_EMAIL");
const FROM_EMAIL = defineString("FROM_EMAIL");

exports.sendLoginNotification = onCall(
  {
    secrets: [RESEND_API_KEY],
    maxInstances: 5
  },
  async (request) => {
    // Only authenticated users may call this function.
    if (!request.auth) {
      throw new HttpsError(
        "unauthenticated",
        "Please sign in first."
      );
    }

    const token = request.auth.token;
    const provider = token.firebase?.sign_in_provider;

    if (provider !== "google.com" || !token.email) {
      throw new HttpsError(
        "permission-denied",
        "Google sign-in is required."
      );
    }

    const uid = request.auth.uid;
    const userEmail = token.email;
    const now = Date.now();

    // Limit notifications to one per user every 5 minutes.
    // This helps prevent email spam from repeated function calls.
    const throttleRef = db.collection("loginNotificationThrottle")
      .doc(uid);

    const allowed = await db.runTransaction(async (tx) => {
      const snapshot = await tx.get(throttleRef);
      const previous = snapshot.exists
        ? snapshot.data().lastSentAt || 0
        : 0;

      if (now - previous < 5 * 60 * 1000) {
        return false;
      }

      tx.set(throttleRef, { lastSentAt: now });
      return true;
    });

    if (!allowed) {
      return { ok: true, message: "Notification recently sent." };
    }

    const loginTime = new Date(now).toISOString();
    const recipient = NOTIFY_EMAIL.value();
    const sender = FROM_EMAIL.value();

    const response = await fetch("https://api.resend.com/emails", {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${RESEND_API_KEY.value()}`,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        from: sender,
        to: [recipient],
        subject: "New Google Login - Your Website",
        text: [
          "A user signed in to your website with Google.",
          "",
          `User email: ${userEmail}`,
          `Login time (UTC): ${loginTime}`,
          `Firebase UID: ${uid}`
        ].join("\n")
      })
    });

    if (!response.ok) {
      // Avoid returning API details or secrets to the browser.
      console.error("Email provider returned status:", response.status);
      throw new HttpsError(
        "internal",
        "Could not send login notification."
      );
    }

    return { ok: true };
  }
);


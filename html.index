FROM_EMAIL=Website Alerts <alerts@your-verified-domain.com>

import { getFunctions, httpsCallable } from
  "https://www.gstatic.com/firebasejs/12.5.0/firebase-functions.js";

const functions = getFunctions(app, "us-central1");
const sendLoginNotification = httpsCallable(
  functions,
  "sendLoginNotification"
);
await signInWithPopup(auth, provider);
const result = await signInWithPopup(auth, provider);

// Login has succeeded. Notification is sent by the server.
status.textContent = "Login successful! Sending notification...";

try {
  await sendLoginNotification();
  status.textContent = "Login successful! Notification sent.";
} catch (error) {
  console.error("Notification failed:", error.code);
  status.textContent =
    "Login successful, but notification could not be sent.";
}

npm install -g firebase-tools
firebase login
firebase init functions
firebase init firestore

cd functions
npm install
cd ..

firebase functions:secrets:set RESEND_API_KEY
firebase deploy --only functions,firestore:rules

firebase deploy --only hosting

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /loginNotificationThrottle/{userId} {
      allow read, write: if false;
    }
  }
}
